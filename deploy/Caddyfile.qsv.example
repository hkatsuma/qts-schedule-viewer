# Install on server-a, not on QNAP. Replace all example addresses.
# This example requires the Tailnet IP in Caddy's network namespace.
# For userspace Tailscale, retain the existing verified Tailnet-only ingress.
https://server-a.tailnet-name.ts.net:8443 {
    bind 100.101.102.103
    tls {
        get_certificate tailscale
    }
    reverse_proxy http://192.168.0.1:18080 {
        # Preserve public host: POST /api/refresh compares Origin against Host.
        header_up Host {http.request.host}
    }
}
# QSV checks TCP peer IP, not X-Forwarded-For, Forwarded or X-Real-IP.
# Keep Uvicorn --no-proxy-headers. No backend token/password/TLS required
# on the trusted home LAN. Tailnet users are governed by the existing ACL.
