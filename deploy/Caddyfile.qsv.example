# Dedicated QSV Tailscale node + Caddy on server-a.
# Use compose.proxy.yaml and proxy/Caddyfile for the runnable configuration.
# Replace the example IP with the NEW container node's actual Tailnet IP.
{
	admin off
	auto_https disable_redirects
}
https://qsv.tailnet-name.ts.net {
	bind 100.101.102.103
	tls {
		get_certificate tailscale
	}
	reverse_proxy http://192.168.0.1:18080 {
		header_up Host {http.request.host}
	}
}
# No host ports. Caddy shares the Tailscale container's network and socket.
# tag:www-server uses existing grants (admins + tag:client, TCP 443).
