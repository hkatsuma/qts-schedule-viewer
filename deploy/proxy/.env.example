# Dedicated QSV node on server-a; not the host's Tailscale identity.
QSV_TS_HOSTNAME=qsv
# Confirm the actual DNSName after login (a duplicate name can gain a suffix).
QSV_PUBLIC_HOST=qsv.tailnet-name.ts.net
# SAFE INITIAL VALUE: replace with `tailscale ip -4` from the new container.
# Do not use server-a's existing Tailnet IP.
QSV_TAILNET_IP=127.0.0.1
QSV_UPSTREAM=192.168.0.1:18080
