# Paths are resolved ON THE QNAP running Docker, not the development PC.
QSV_CRONTAB_SOURCE=/etc/config/crontab
QSV_TIMEZONE=Asia/Tokyo
QSV_REFRESH_SECONDS=300
QSV_UID=10001
QSV_GID=10001
# REQUIRED: QNAP LAN IP (not 0.0.0.0), and an unused dedicated HTTP port.
QSV_BIND_IP=
QSV_BIND_PORT=18080
# REQUIRED: actual peer IP of server-a as observed by QSV.
# Comma-separated individual IPv4/IPv6 addresses. No CIDR or wildcard.
# Example only: QSV_ALLOWED_PROXY_IPS=192.168.0.2,192.168.0.3
QSV_ALLOWED_PROXY_IPS=

# Annotation DB uses the QNAP-local qsv-data Docker volume (/data/qsv.sqlite3).
